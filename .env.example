# Public Supabase settings only. Production values belong in Netlify's
# production context; deploy previews must not receive these values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_ORIGIN=http://127.0.0.1:8888
# Server function configuration (same project/public key, never service_role).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only Cora and Microsoft settings. Never use a VITE_ prefix here.
SUPABASE_SECRET_KEY=
# Claude API key for Cora (or leave unset where Netlify AI Gateway injects
# ANTHROPIC_API_KEY and ANTHROPIC_BASE_URL). Model and effort are optional.
ANTHROPIC_API_KEY=
# CORA_MODEL=claude-opus-5
# CORA_EFFORT=medium
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TOKEN_ENCRYPTION_KEY=
# Local OAuth only; production defaults to https://cmd.hillspafl.gov.
# MICROSOFT_APP_ORIGIN=http://127.0.0.1:8888
